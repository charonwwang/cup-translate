{
    "build": {
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build",
        "devPath": "http://localhost:1420",
        "distDir": "../dist",
        "withGlobalTauri": false
    },
    "package": {
        "productName": "cup-translate",
        "version": "3.0.11"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "shell": {
                "all": false,
                "open": ".*"
            },
            "path": {
                "all": true
            },
            "window": {
                "all": true
            },
            "clipboard": {
                "all": true
            },
            "globalShortcut": {
                "all": true
            },
            "notification": {
                "all": true
            },
            "http": {
                "all": true,
                "request": true,
                "scope": [
                    "http://**",
                    "https://**"
                ]
            },
            "os": {
                "all": true
            },
            "protocol": {
                "asset": true,
                "assetScope": [
                    "$CACHE/**",
                    "$CONFIG/**"
                ]
            },
            "fs": {
                "all": true,
                "scope": [
                    "$APPCONFIG/**",
                    "$APPCACHE/**"
                ]
            },
            "dialog": {
                "open": true,
                "save": true
            },
            "process": {
                "relaunch": true
            }
        },
        "bundle": {
            "active": true,
            "category": "Utility",
            "copyright": "GPLv3",
            "targets": "all",
            "identifier": "com.cup-translate.app",
            "longDescription": "cup-translate - a lightweight, selection-first translation tool. Community fork of pot-desktop, with first-class Linux/Wayland support.",
            "shortDescription": "cup-translate",
            "externalBin": [],
            "resources": [
                "resources/ocr-aarch64-apple-darwin",
                "resources/ocr-x86_64-apple-darwin"
            ],
            "icon": [
                "icons/32x32.png",
                "icons/128x128.png",
                "icons/128x128@2x.png",
                "icons/icon.icns",
                "icons/icon.ico"
            ],
            "deb": {
                "depends": [
                    "libxdo3",
                    "libxcb1",
                    "libxrandr2",
                    "tesseract-ocr",
                    "libwebkit2gtk-4.1-0",
                    "libjavascriptcoregtk-4.1-0",
                    "libgtk-3-0",
                    "libayatana-appindicator3-1"
                ]
            },
            "rpm": {
                "depends": [
                    "libxdo",
                    "libxcb",
                    "libXrandr",
                    "tesseract"
                ]
            },
            "macOS": {
                "entitlements": null,
                "exceptionDomain": "",
                "frameworks": [],
                "providerShortName": null,
                "signingIdentity": null
            },
            "dmg": {
                "appPosition": {
                    "x": 180,
                    "y": 170
                },
                "applicationFolderPosition": {
                    "x": 480,
                    "y": 170
                },
                "windowSize": {
                    "width": 660,
                    "height": 400
                }
            }
        },
        "security": {
            "csp": "default-src 'self'; connect-src ipc: http: https:; img-src 'self' asset: http: https: data:; media-src 'self' asset: blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'unsafe-eval';",
            "devCsp": "default-src 'self'; connect-src ipc: http: https: ws:; img-src 'self' asset: http: https: data:; media-src 'self' asset: blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'unsafe-eval';"
        },
        "windows": [
            {
                "title": "Daemon",
                "label": "daemon",
                "visible": false,
                "url": "daemon.html"
            }
        ],
        "systemTray": {
            "iconPath": "icons/icon.png",
            "iconAsTemplate": true
        },
        "updater": {
            "active": true,
            "dialog": false,
            "endpoints": [
                "https://github.com/charonwwang/cup-translate/releases/latest/download/update.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNDIwMzAzNTIwRTBDQjUKUldTMURBNVNBd05DMjZFK3pOMHFmd1JSd2RFcWtxSXhFMGRKQVdNRTJXaWpzSUdXOWJmd1pPaXIK"
        }
    }
}
