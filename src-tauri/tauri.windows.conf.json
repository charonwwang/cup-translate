{
    "tauri": {
        "systemTray": {
            "iconPath": "icons/icon.ico",
            "iconAsTemplate": true
        },
        "bundle": {
            "windows": {
                "certificateThumbprint": null,
                "digestAlgorithm": "sha256",
                "timestampUrl": "",
                "webviewInstallMode": {
                    "silent": true,
                    "type": "embedBootstrapper"
                },
                "nsis": {
                    "displayLanguageSelector": true,
                    "installerIcon": "icons/icon.ico",
                    "license": "../LICENSE",
                    "installMode": "perMachine",
                    "languages": [
                        "SimpChinese",
                        "TradChinese",
                        "English"
                    ],
                    "headerImage": "../packaging/windows/nsis-header.bmp",
                    "sidebarImage": "../packaging/windows/nsis-sidebar.bmp"
                },
                "wix": {
                    "language": "en-US",
                    "license": "../LICENSE",
                    "bannerPath": "../packaging/windows/wix-banner.bmp",
                    "dialogImagePath": "../packaging/windows/wix-dialog.bmp"
                }
            }
        }
    }
}
